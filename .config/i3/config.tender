##################################################### Конфигурационный файл i3wm ##############################

# Кнопка MOD
set $mod Mod4

# Раскладка клавиатуры
exec --no-startup-id setxkbmap -layout us,ru,ua -option "grp:alt_shift_toggle"
exec_always --no-startup-id xmodmap ~/.xmodmaprc

#################################################### Декорации окон ###########################################
default_border pixel 0
for_window [tiling] border pixel 0
for_window [floating] border pixel 0
gaps inner 4
gaps outer 1

# Шрифты
font pango:Iosevka Nerd Font 10
font pango:Symbols Nerd Font 12

########################################################## Автостарт ##########################################
exec --no-startup-id dex --autostart --environment i3
exec_always --no-startup-id "xrdb ~/.Xresources"
exec --no-startup-id ~/.config/i3/layout_notify.sh
exec --no-startup-id "xfce4-power-manager"
exec --no-startup-id blueman-applet
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY I3SOCK
exec --no-startup-id lxpolkit
exec --no-startup-id "unclutter-xfixes --timeout 1 --jitter 1 --ignore-buttons 4,5,6,7 --hide-on-touch --start-hidden"
exec --no-startup-id xss-lock --transfer-sleep-lock -- betterlockscreen -l
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id dunst
exec --no-startup-id picom --experimental-backends --config ~/.config/picom.conf
# wpgtk и pywal закомментированы — исполь8зуем tender
exec_always --no-startup-id feh --randomize --bg-fill ~/Изображения/Обои/
#exec_always --no-startup-id bash -c "~/.local/bin/wpg -s ~/Изображения/Обои"
#exec_always --no-startup-id bash -c "sleep 1 && wal-telegram --wal -g|--gaussian-blur"
#exec_always --no-startup-id bash -c "sleep 3 && python3 ~/.local/bin/papirus-wal.py"
exec --no-startup-id betterlockscreen -u ~/Изображения/Обои/
exec_always --no-startup-id autotiling --limit 2
exec_always --no-startup-id python3 ~/.config/i3/i3-window.py
exec --no-startup-id echo "⚖️ Bal" > /tmp/current_power_profile && sudo /usr/local/bin/ryzenadj --stapm-limit=15000 --fast-limit=18000 --slow-limit=15000 --tctl-temp=65
exec --no-startup-id easyeffects

########################################################## Цвета ##############################################

# Tender palette
set $tender_bg      #282828
set $tender_fg      #eeeeee
set $tender_blue    #b3deef
set $tender_cyan    #73cef4
set $tender_lime    #c9d05c
set $tender_red     #f43753
set $tender_yellow  #ffc24b

# class                 border          backgr.         text            indicator       child_border
client.focused          $tender_blue    $tender_blue    $tender_bg      $tender_cyan    $tender_blue
client.focused_inactive $tender_bg      $tender_bg      $tender_fg      $tender_bg      $tender_bg
client.unfocused        $tender_bg      $tender_bg      $tender_fg      $tender_bg      $tender_bg
client.urgent           $tender_red     $tender_red     $tender_fg      $tender_red     $tender_red
client.placeholder      $tender_bg      $tender_bg      $tender_fg      $tender_bg      $tender_bg
client.background       $tender_bg

#################################################### Правила открытия окон ####################################

for_window [class="mpv"] floating enable, move absolute position center
for_window [class="Viewnior"] floating enable, move absolute position center
for_window [class="Pavucontrol"] floating enable, move absolute position center
for_window [class="Catfish"] floating enable, move absolute position top
for_window [class="Alacritty" title="calcurse"] floating enable
for_window [class="nm-connection-editor"] floating enable, move absolute position top
for_window [instance="nmtui_float"] floating enable, resize set 700 500, move position center
for_window [class="monitask"] floating enable, move absolute position center
for_window [class="telegram-desktop"] floating enable, move absolute position right
for_window [instance="telegram-desktop"] floating enable, move absolute position right
for_window [class="Blueman-manager"] floating enable, move absolute position center
for_window [class="easyeffects"] move scratchpad
for_window [class="transmission-gtk"] floating enable, move absolute position center
for_window [class="Lutris"] floating enable
for_window [class="(?i)libreoffice*"] move to workspace $ws2
for_window [class="Wine"] floating enable
for_window [title="Wine System Config"] floating enable

assign [instance="firefox"] $ws1
assign [instance="transmission-gtk"] $ws3
assign [class="(?i)GIMP"] $ws5
assign [instance="thunar"] $ws3
assign [instance="shotcut"] $ws5
assign [class="alacritty" instance="MOC"] $ws5
assign [class="alacritty" instance="cava"] $ws5
assign [class="(?i)libreoffice"] $ws2
assign [class="(?i)libreoffice-writer"] $ws2
assign [class="(?i)libreoffice-calc"] $ws2
assign [class="(?i)libreoffice-impress"] $ws2
assign [class="(?i)libreoffice-draw"] $ws2
assign [class="(?i)libreoffice-startcenter"] $ws2
assign [class="easyeffects"] $ws5
assign [instance="Krita"] $ws5
assign [instance="Blender"] $ws5
assign [instance="(?i)Zathura"] $ws4

#################################################### Звук и яркость экрана ####################################

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+ && dunstify -h string:x-dunst-stack-tag:volume -a "System" "Громкость: $(pamixer --get-volume-human)" -h int:value:"$(pamixer --get-volume)"
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%- && dunstify -h string:x-dunst-stack-tag:volume -a "System" "Громкость: $(pamixer --get-volume-human)" -h int:value:"$(pamixer --get-volume)"
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && dunstify -h string:x-dunst-stack-tag:volume -a "System" "Звук переключен"
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5% && dunstify -h string:x-dunst-stack-tag:brightness -a "System" "Яркость: $(brightnessctl info | grep -oP '\(\K[^)]+') "
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- && dunstify -h string:x-dunst-stack-tag:brightness -a "System" "Яркость: $(brightnessctl info | grep -oP '\(\K[^)]+') "

################################################# Программы ##################################################

bindsym $mod+Return exec alacritty
bindsym $mod+grave exec ~/.config/i3/scratchpad.sh
bindsym $mod+d exec --no-startup-id PATH="$PATH:/usr/games" rofi -show drun -show-icons -font "Iosevka Nerd Font 17" -theme ~/.config/rofi/theme.rasi
bindsym --release Print exec "flameshot gui"
bindsym $mod+Shift+p exec thunar
bindsym $mod+g exec firefox
bindsym $mod+c exec alacritty -e nvim
bindsym $mod+t exec ~/.config/i3/telegram-scratch.sh
bindsym $mod+b exec transmission-gtk
bindsym $mod+y exec catfish
bindsym $mod+m exec monitask
bindsym $mod+s exec shotcut
bindsym $mod+e [class="easyeffects"] move workspace current, focus
bindsym Mod4+z exec "alacritty --class player -e mocp"

############################################### Горячие клавиши ##############################################

floating_modifier $mod
tiling_drag modifier titlebar
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+Tab workspace next

set $ws1 "1:"
set $ws2 "2:󰪸"
set $ws3 "3:"
set $ws4 "4:"
set $ws5 "5:"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

mode "resize" {
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+r mode "resize"
