return {
  {
    "catppuccin/nvim",
    name     = "catppuccin",
    lazy     = false,
    priority = 1000,
    config   = function()
      require("catppuccin").setup({
        flavour = "mocha", -- latte, frappe, macchiato, mocha

        integrations = {
          -- все твои плагины — catppuccin красит их сам
          treesitter    = true,
          telescope     = { enabled = true },
          neo_tree      = true,
          lualine       = true,
          barbar        = true,
          gitsigns      = true,
          cmp           = true,
          mason         = true,
          which_key     = true,
          indent_blankline = { enabled = true },
          aerial        = true,
          native_lsp    = {
            enabled = true,
            virtual_text = {
              errors      = { "italic" },
              hints       = { "italic" },
              warnings    = { "italic" },
              information = { "italic" },
            },
            underlines = {
              errors      = { "underline" },
              hints       = { "underline" },
              warnings    = { "underline" },
              information = { "underline" },
            },
          },
        },
      })

      vim.cmd("colorscheme catppuccin")
    end,
  },
}
